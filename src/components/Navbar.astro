---
import { business } from "../data/business";
---

<header class="site-header">
    <div
        class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-5 lg:px-12"
    >
        <a class="brand-mark" href="#top" aria-label="Vanguard Auto home">
            <span class="brand-mark__symbol" aria-hidden="true">V</span>
            <span>{business.shortName}</span>
        </a>
        <nav
            class="hidden items-center gap-8 text-sm font-semibold text-slate-300 md:flex"
            aria-label="Main navigation"
        >
            <a class="nav-link" href="#services">Services</a>
            <a class="nav-link" href="#gallery">Gallery</a>
            <a class="nav-link" href="#location">Location</a>
        </nav>
        <a
            class="button button--small button--outline"
            href={business.phoneHref}>Call now</a
        >
    </div>
</header>
