---
import { business } from "../data/business";
---

<section id="top" class="hero-section" aria-labelledby="hero-heading">
    <div class="wrap hero__inner">
        <div class="hero__copy">
            <p class="eyebrow">Independent automotive care · Dubai &amp; Sharjah, UAE</p>
            <h1 id="hero-heading">Keep the craft.<br /><span>Lose the worry.</span></h1>
            <p class="hero-copy">
                From first diagnosis to final handover, Vanguard keeps every
                vehicle moving through a considered process — clear updates,
                honest work, and no surprises at pickup.
            </p>
            <div class="button-row">
                <a
                    class="button button--whatsapp"
                    href={business.contact.whatsapp.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    >Request a vehicle assessment <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a
                >
                <a class="button button--ghost" href="#services"
                    >Explore services <span aria-hidden="true">↓</span></a
                >
            </div>
        </div>
        <div class="hero__aside">
            <div class="about-panel">
                <span class="eyebrow">Who we are</span>
                <h2>About Vanguard</h2>
                <p>We specialise in vehicle maintenance, diagnostics, and mechanical repairs for German, British, Japanese, and Korean vehicles. Our experience covers everything from routine servicing and air conditioning repairs to complex engine and transmission replacements.</p>
                <p>Through our partnerships with trusted specialist workshops, we ensure that every vehicle receives the appropriate expertise and attention it deserves.</p>
                <p>Transparency, trust, and customer satisfaction are at the heart of our service. We believe in keeping our customers informed at every stage, providing clear explanations, regular updates, and photographic evidence of our findings and completed work. Our goal is not only to maintain and repair your vehicle, but also to help you understand its needs, make informed decisions, and feel confident in the service you receive.</p>
                <p class="about-close">Your vehicle is in capable hands, with honest advice, clear communication, and quality service from start to finish.</p>
            </div>
        </div>
    </div>
</section>
