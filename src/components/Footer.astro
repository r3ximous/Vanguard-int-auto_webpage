---
import { business } from "../data/business";
---

<footer class="border-t border-white/10 bg-slate-950">
    <div
        class="mx-auto flex max-w-7xl flex-col gap-6 px-6 py-10 text-sm text-slate-400 sm:flex-row sm:items-end sm:justify-between lg:px-12"
    >
        <div>
            <a class="brand-mark" href="#top"
                ><span class="brand-mark__symbol" aria-hidden="true">V</span
                ><span>{business.shortName}</span></a
            ><p class="mt-4 max-w-xs leading-6">
                Independent automotive care in the UAE, with the details kept in
                view.
            </p>
        </div><div class="sm:text-right">
            <a class="footer-link" href={`mailto:${business.email}`}
                >{business.email}</a
            ><p class="mt-2">
                © {new Date().getFullYear()} Vanguard International Automotive L.L.C
            </p>
        </div>
    </div>
</footer>
