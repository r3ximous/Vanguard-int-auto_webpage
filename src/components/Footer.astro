---
import { business } from "../data/business";
---

<footer>
    <div class="wrap footer-top">
        <div>
            <a class="brand-mark" href="#top"
                ><span class="brand-mark__symbol" aria-hidden="true">V</span
                ><span>{business.shortName}</span></a
            >            <p>Independent automotive care in the UAE, with the details kept in view.</p>
        </div><div class="footer-links">
            <a href={business.contact.email.href}>{business.contact.email.address}</a>
            <a href={business.contact.phone.href}>{business.contact.phone.display}</a>
            <p>© {new Date().getFullYear()} Vanguard International Automotive L.L.C</p>
        </div>
    </div>
    <div class="wrap footer-bottom">Built around honest advice, clear communication, and quality service.</div>
</footer>
