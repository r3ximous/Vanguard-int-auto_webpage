---
import { business, services } from "../data/business";
---

<section id="services" class="section-band section-band--light" aria-labelledby="services-heading">
    <div class="wrap section-padding">
        <div class="section-intro">
            <p class="eyebrow">What we do</p>
            <div>
                <h2 id="services-heading">Good work begins <em>with good listening.</em></h2>
            </div>
        </div>
        <div class="services-grid">
            {
                services.map((service, index) => (
                    <article class={`service-card service-card--${index + 1}`} data-service-card>
                        <details>
                            <summary class="service-card__summary" aria-label={`Open ${service.title} details`}>
                                <span>{service.number}</span>
                                <h3>{service.title}</h3>
                                <p>{service.description}</p>
                            </summary>
                            <div class="service-card__content">
                                <p class="service-card__detail">{service.detail}</p>
                                <a class="button button--outline-dark" href={`https://wa.me/${business.contact.phone.display.replace(/\D/g, '')}?text=${encodeURIComponent(service.whatsappMessage)}`} target="_blank" rel="noopener noreferrer">Ask about {service.title}<span aria-hidden="true">↗</span></a>
                            </div>
                        </details>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<script>
    const serviceCards = document.querySelectorAll<HTMLElement>('[data-service-card]');

    const setServiceState = (card: HTMLElement, open: boolean) => {
        const details = card.querySelector<HTMLDetailsElement>('details');
        const content = card.querySelector<HTMLElement>('.service-card__content');
        if (!details || !content) return;

        if (open) details.open = true;
        card.classList.toggle('is-open', open);
        details.querySelector('summary')?.setAttribute('aria-expanded', String(open));
        if (open) {
            content.style.maxHeight = `${content.scrollHeight}px`;
        } else {
            content.style.maxHeight = '0px';
        }
    };

    serviceCards.forEach((card) => {
        const details = card.querySelector<HTMLDetailsElement>('details');
        const summary = card.querySelector<HTMLElement>('summary');
        const content = card.querySelector<HTMLElement>('.service-card__content');
        if (!details || !summary || !content) return;

        summary.setAttribute('aria-expanded', 'false');
        setServiceState(card, false);

        card.addEventListener('click', (event) => {
            if ((event.target as HTMLElement).closest('a')) return;
            event.preventDefault();
            setServiceState(card, !details.open);
        });

        content.addEventListener('transitionend', (event) => {
            if (event.propertyName === 'max-height' && !card.classList.contains('is-open')) {
                details.open = false;
            }
        });

        window.addEventListener('resize', () => {
            if (details.open) setServiceState(card, true);
        });
    });
</script>
