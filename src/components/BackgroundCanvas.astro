<div id="canvas-container" aria-hidden="true">
    <canvas id="webgl-canvas"></canvas>
</div>

<script>
    import * as THREE from "three";

    class VanguardCarScene {
        private scene = new THREE.Scene();
        private camera = new THREE.PerspectiveCamera(35, 1, 0.1, 100);
        private renderer: THREE.WebGLRenderer;
        private car = new THREE.Group();
        private targetScroll = 0;
        private currentScroll = 0;
        private frame = 0;
        private reducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        constructor(canvas: HTMLCanvasElement) {
            this.renderer = new THREE.WebGLRenderer({
                canvas,
                alpha: true,
                antialias: true,
                powerPreference: "high-performance",
            });
            this.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
            this.scene.add(this.car);
            this.createCar();
            this.createLighting();
            this.updateSize();
            this.updateScroll();
            window.addEventListener("resize", this.updateSize);
            window.addEventListener("scroll", this.updateScroll, {
                passive: true,
            });
            this.animate();
        }

        private createCar() {
            const bodyMaterial = new THREE.MeshPhysicalMaterial({ color: 0x202b2b, metalness: 0.8, roughness: 0.2, clearcoat: 0.8, clearcoatRoughness: 0.14 });
            const trimMaterial = new THREE.MeshStandardMaterial({
                color: 0xd56b3e,
                metalness: 0.55,
                roughness: 0.3,
            });
            const glassMaterial = new THREE.MeshPhysicalMaterial({ color: 0x182a2d, metalness: 0.35, roughness: 0.08, clearcoat: 1, clearcoatRoughness: 0.08 });
            const tyreMaterial = new THREE.MeshStandardMaterial({
                color: 0x111716,
                roughness: 0.9,
            });
            const chromeMaterial = new THREE.MeshStandardMaterial({ color: 0xb6c3bf, metalness: 0.9, roughness: 0.18 });
            const lightMaterial = new THREE.MeshStandardMaterial({ color: 0xffe3a1, emissive: 0xffb347, emissiveIntensity: 2 });
            const redLightMaterial = new THREE.MeshStandardMaterial({ color: 0x9d1f22, emissive: 0x700000, emissiveIntensity: 1.5 });

            const bodyShape = new THREE.Shape();
            bodyShape.moveTo(-1.86, 0.02);
            bodyShape.lineTo(-1.72, 0.42);
            bodyShape.lineTo(-1.12, 0.54);
            bodyShape.lineTo(-0.55, 1.02);
            bodyShape.quadraticCurveTo(-0.32, 1.18, 0.08, 1.18);
            bodyShape.lineTo(0.8, 1.06);
            bodyShape.quadraticCurveTo(1.18, 0.97, 1.38, 0.58);
            bodyShape.lineTo(1.82, 0.5);
            bodyShape.lineTo(1.94, 0.18);
            bodyShape.lineTo(1.84, 0.02);
            bodyShape.closePath();
            const body = new THREE.Mesh(new THREE.ExtrudeGeometry(bodyShape, { depth: 1.28, bevelEnabled: true, bevelSegments: 3, bevelSize: 0.08, bevelThickness: 0.08 }), bodyMaterial);
            body.geometry.translate(0, 0, -0.64);
            this.car.add(body);

            const windowShape = new THREE.Shape();
            windowShape.moveTo(-0.82, 0);
            windowShape.lineTo(-0.38, 0.42);
            windowShape.lineTo(0.08, 0.42);
            windowShape.lineTo(0.58, 0.32);
            windowShape.lineTo(0.78, 0);
            windowShape.closePath();
            [-0.651, 0.651].forEach((z) => {
                const window = new THREE.Mesh(new THREE.ExtrudeGeometry(windowShape, { depth: 0.025, bevelEnabled: true, bevelSize: 0.02, bevelThickness: 0.01 }), glassMaterial);
                window.position.set(-0.12, 0.75, z);
                window.rotation.y = z < 0 ? Math.PI : 0;
                this.car.add(window);
            });

            const sideStripe = new THREE.Mesh(new THREE.BoxGeometry(2.45, 0.035, 0.035), trimMaterial);
            sideStripe.position.set(0, 0.45, 0.66);
            this.car.add(sideStripe);

            [-1.05, 1.05].forEach((x) => {
                [-0.68, 0.68].forEach((z) => {
                    const wheel = new THREE.Mesh(new THREE.TorusGeometry(0.34, 0.12, 12, 24), tyreMaterial);
                    wheel.position.set(x, -0.22, z);
                    this.car.add(wheel);
                    const hub = new THREE.Mesh(new THREE.CylinderGeometry(0.17, 0.17, 0.08, 20), chromeMaterial);
                    hub.rotation.x = Math.PI / 2;
                    hub.position.set(x, -0.22, z + (z > 0 ? 0.11 : -0.11));
                    this.car.add(hub);
                });
            });

            [-0.56, 0.56].forEach((z) => {
                const headlight = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.14, 0.26), lightMaterial);
                headlight.position.set(2.14, 0.38, z);
                this.car.add(headlight);
                const tailLight = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.11, 0.24), redLightMaterial);
                tailLight.position.set(-1.88, 0.4, z);
                this.car.add(tailLight);
            });

            const grille = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.18, 0.58), chromeMaterial);
            grille.position.set(1.95, 0.22, 0);
            this.car.add(grille);
            [-0.77, 0.77].forEach((z) => {
                const mirror = new THREE.Mesh(new THREE.SphereGeometry(0.1, 12, 8), bodyMaterial);
                mirror.scale.set(1.2, 0.65, 0.8);
                mirror.position.set(0.96, 0.83, z);
                this.car.add(mirror);
            });
            this.car.rotation.y = -0.38;
            this.car.scale.setScalar(0.92);
        }

        private createLighting() {
            this.scene.add(new THREE.HemisphereLight(0xf5f3ee, 0x202b2b, 2.2));
            const keyLight = new THREE.DirectionalLight(0xffffff, 3);
            keyLight.position.set(4, 6, 6);
            this.scene.add(keyLight);
            const accentLight = new THREE.PointLight(0xd56b3e, 18, 14);
            accentLight.position.set(-4, 1, 3);
            this.scene.add(accentLight);
        }

        private updateScroll = () => {
            const scrollableHeight = Math.max(
                document.documentElement.scrollHeight - window.innerHeight,
                1,
            );
            this.targetScroll = Math.min(window.scrollY / scrollableHeight, 1);
            if (this.reducedMotion) this.currentScroll = this.targetScroll;
        };

        private updateSize = () => {
            this.camera.aspect = window.innerWidth / window.innerHeight;
            this.camera.updateProjectionMatrix();
            this.renderer.setSize(window.innerWidth, window.innerHeight, false);
            this.camera.position.z = window.innerWidth < 640 ? 8.5 : 7;
        };

        private animate = () => {
            this.frame = requestAnimationFrame(this.animate);
            if (!this.reducedMotion)
                this.currentScroll +=
                    (this.targetScroll - this.currentScroll) * 0.085;
            this.car.position.y = 1.05 - this.currentScroll * 3.4;
            this.car.position.x =
                (window.innerWidth < 640 ? 0.75 : 1.95) +
                Math.sin(this.currentScroll * Math.PI * 2) * 0.42;
            this.car.rotation.z =
                Math.sin(this.currentScroll * Math.PI * 2) * 0.08;
            if (!this.reducedMotion) this.car.rotation.x += 0.0015;
            this.renderer.render(this.scene, this.camera);
        };

        dispose() {
            cancelAnimationFrame(this.frame);
            window.removeEventListener("resize", this.updateSize);
            window.removeEventListener("scroll", this.updateScroll);
            this.car.traverse((object) => {
                if (object instanceof THREE.Mesh) {
                    object.geometry.dispose();
                    object.material.dispose();
                }
            });
            this.renderer.dispose();
        }
    }

    let scene: VanguardCarScene | undefined;
    function initThree() {
        const canvas = document.getElementById("webgl-canvas");
        if (canvas instanceof HTMLCanvasElement)
            scene = new VanguardCarScene(canvas);
    }
    document.addEventListener("astro:page-load", initThree);
    document.addEventListener("astro:before-swap", () => scene?.dispose());
</script>
