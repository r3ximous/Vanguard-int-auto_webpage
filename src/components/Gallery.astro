---
const galleryItems = [
    {
        title: "Bodywork, with restraint",
        label: "IMG_01",
    },
    {
        title: "The finish matters",
        label: "IMG_02",
    },
    {
        title: "Look closer",
        label: "IMG_03",
    },
] as const;
---

<section id="gallery" class="section-band section-band--light" aria-labelledby="gallery-heading">
    <div class="wrap section-padding">
        <div class="section-intro">
            <div>
                <p class="eyebrow">A glimpse of the approach</p><h2 id="gallery-heading">
                    Precision shows up<br /><em>in the small things.</em>
                </h2>
            </div><p>
                A considered approach to every detail, from first inspection to final handover.
            </p>
        </div>
        <div class="gallery-grid">
            {
                galleryItems.map((item) => (
                    <figure class="gallery-card">
                        <div class="gallery-image">
                            <span>WORKSHOP PHOTOGRAPHY<br />PENDING</span>
                        </div>
                        <figcaption>
                            <span>{item.title}</span><small>{item.label}</small>
                        </figcaption>
                    </figure>
                ))
            }
        </div>
    </div>
</section>
