---
import diagnosticsArt from "../assets/gallery/diagnostics.svg";
import bodyworkArt from "../assets/gallery/bodywork.svg";
import detailingArt from "../assets/gallery/detailing.svg";

// Placeholder media until approved Vanguard workshop photography arrives.
// Swap these SVGs for real photos in the same card structure when available.
const galleryItems = [
    {
        art: bodyworkArt,
        title: "Bodywork, with restraint",
        label: "Workshop photo coming soon",
        alt: "Illustration placeholder representing a vehicle bodywork repair",
    },
    {
        art: detailingArt,
        title: "The finish matters",
        label: "Workshop photo coming soon",
        alt: "Illustration placeholder representing exterior detailing",
    },
    {
        art: diagnosticsArt,
        title: "Look closer",
        label: "Workshop photo coming soon",
        alt: "Illustration placeholder representing diagnostics on a workshop screen",
    },
] as const;

const testimonials = [
    {
        quote: "They explained the fault before touching anything, and the price never moved. Rare.",
        author: "Customer · Al Hamra",
    },
    {
        quote: "Dent gone, original paint kept. I could not tell where it had been.",
        author: "Customer · Al Nakheel",
    },
    {
        quote: "Booked by WhatsApp, dropped off at 8, drove home in the afternoon. Easy.",
        author: "Customer · Ras Al Khaimah City",
    },
] as const;
---

<section id="gallery" class="section-band section-band--dark" aria-labelledby="gallery-heading">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-32">
        <div
            class="flex flex-col justify-between gap-8 md:flex-row md:items-end"
        >
            <div>
                <p class="eyebrow">A glimpse of the approach</p><h2
                    id="gallery-heading"
                    class="section-title mt-5 max-w-2xl text-white"
                >
                    Precision shows up<br /><em>in the small things.</em>
                </h2>
            </div><p class="max-w-sm text-sm leading-6 text-slate-400">
                Temporary development media is shown here while approved
                Vanguard workshop photography is being prepared.
            </p>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-3">
            {
                galleryItems.map((item, index) => (
                    <figure class="gallery-card" data-reveal style={`--reveal-index: ${index}`}>
                        <div class="overflow-hidden rounded-t-lg">
                            <img
                                src={item.art.src}
                                alt={item.alt}
                                width="800"
                                height="600"
                                loading="lazy"
                                decoding="async"
                                sizes="(min-width: 768px) 33vw, 100vw"
                                class="gallery-placeholder"
                            />
                        </div>
                        <figcaption class="flex justify-between gap-4 border-t border-white/15 pt-4 text-sm">
                            <span class="font-semibold text-white">
                                {item.title}
                            </span>
                            <span class="text-right text-slate-500">
                                {item.label}
                            </span>
                        </figcaption>
                    </figure>
                ))
            }
        </div>
        <h3 class="sr-only">What customers say about working with Vanguard</h3>
        <div class="mt-14 grid gap-5 md:grid-cols-3">
            {
                testimonials.map((testimonial, index) => (
                    <figure class="testimonial-card" data-reveal style={`--reveal-index: ${index}`}>
                        <blockquote>“{testimonial.quote}”</blockquote>
                        <figcaption>{testimonial.author}</figcaption>
                    </figure>
                ))
            }
        </div>
        <p class="mt-8 text-center text-xs uppercase tracking-[0.18em] text-slate-500">
            Illustrations are placeholders · real project photos and verified reviews added once available
        </p>
    </div>
</section>
