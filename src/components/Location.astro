---
import { business } from '../data/business';
---

<section id="location" class="section-band section-band--light">
	<div class="mx-auto grid max-w-7xl gap-14 px-6 py-24 lg:grid-cols-[0.8fr_1.2fr] lg:px-12 lg:py-32">
		<div><p class="eyebrow eyebrow--dark">Find Vanguard</p><h2 class="section-title mt-5 text-slate-950">A workshop<br /><em>in transition.</em></h2><p class="mt-6 leading-7 text-slate-600">Our garage is currently changing location. We are keeping the details below visible for continuity, but please confirm the current drop-off point with us before you travel.</p><a class="button button--dark mt-8" href={business.whatsappHref} target="_blank" rel="noreferrer">Confirm the current location <span aria-hidden="true">↗</span></a></div>
		<div class="location-panel"><div class="location-panel__pin" aria-hidden="true">+</div><p class="eyebrow eyebrow--dark">Provisional details</p><address class="mt-5 not-italic text-xl font-semibold leading-8 text-slate-950">{business.address}</address><dl class="mt-8 grid gap-5 border-t border-slate-300 pt-6 text-sm sm:grid-cols-2"><div><dt class="font-bold uppercase tracking-widest text-slate-500">Hours</dt><dd class="mt-2 text-slate-800">{business.hours}</dd></div><div><dt class="font-bold uppercase tracking-widest text-slate-500">Navigation</dt><dd class="mt-2 text-slate-800">Exact map pin coming soon</dd></div></dl></div>
	</div>
</section>
