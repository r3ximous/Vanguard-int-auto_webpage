---
import { business } from "../data/business";
---

<section id="location" class="section-band section-band--light" aria-labelledby="location-heading" data-location-address={business.location.displayAddress}>
    <div class="wrap section-padding location-layout">
        <div>
            <p class="eyebrow eyebrow--dark">Find Vanguard</p><h2
                id="location-heading"
                class="section-title mt-5 text-slate-950"
            >
                A workshop <em>in transition.</em>
            </h2>                        <p>
                Our garage is changing location. Details below are kept visible
                for continuity — please confirm the current drop-off point before
                you travel.
            </p><a class="button button--dark" href={business.contact.whatsapp.href}
                target="_blank"
                rel="noopener noreferrer"
                >Confirm your appointment <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span
                ></a>
        </div>
        <div class="location-panel">
            <span class="transit-badge"><i></i> Currently relocating</span>
            <h3>Provisional details</h3>
            <address>{business.location.displayAddress}</address>
            <dl>
                <div><dt>Hours</dt><dd>{business.location.hours}</dd></div>
                <div><dt>Navigation</dt><dd>Search your area for directions</dd></div>
            </dl>
            <form class="location-search" data-location-search>
                <label for="location-query">Search for your area</label>
                <div><input id="location-query" name="location" placeholder="Dubai, Sharjah..." /><button type="submit">Open directions ↗</button></div>
            </form>
        </div>
    </div>
</section>

<script>
    const locationForm = document.querySelector<HTMLFormElement>('[data-location-search]');
    locationForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        const query = new FormData(locationForm).get('location')?.toString().trim() || 'Ras Al Khaimah, UAE';
        const address = locationForm.closest('[data-location-address]')?.getAttribute('data-location-address') ?? 'Ras Al Khaimah, UAE';
        const destination = `${query}, ${address}`;
        window.open(`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(destination)}`, '_blank', 'noopener');
    });
</script>
