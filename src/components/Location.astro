---
import { business } from "../data/business";
---

<section id="location" class="section-band section-band--light" aria-labelledby="location-heading">
    <div
        class="mx-auto grid max-w-7xl gap-14 px-6 py-24 lg:grid-cols-[0.8fr_1.2fr] lg:px-12 lg:py-32"
    >
        <div>
            <p class="eyebrow eyebrow--dark">Find Vanguard</p><h2
                id="location-heading"
                class="section-title mt-5"
            >
                Care that works<br /><em>around your day.</em>
            </h2><p class="mt-6 leading-7 text-[color:var(--muted)]">
                Vanguard serves drivers across Ras Al Khaimah by appointment. Message us
                before you travel and we will confirm the current drop-off point and the
                best time for your vehicle.
            </p><a
                class="button button--dark mt-8"
                href={business.contact.whatsapp.href}
                target="_blank"
                rel="noopener noreferrer"
                >Confirm your appointment <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span
                ></a>
        </div>
        <div class="location-panel" data-reveal>
            <div class="location-panel__pin" aria-hidden="true">+</div><p
                class="eyebrow eyebrow--dark"
            >
                Appointment details
            </p><address
                class="mt-5 not-italic text-xl font-semibold leading-8"
            >
                {business.location.serviceArea}<br /><span class="block mt-2 text-sm font-normal leading-6 text-[color:var(--muted)]">{business.location.displayAddress}</span>
            </address><dl
                class="mt-8 grid gap-5 border-t border-[color:var(--line)] pt-6 text-sm sm:grid-cols-2"
            >
                <div>
                    <dt
                        class="font-bold uppercase tracking-widest text-[color:var(--muted)]"
                    >
                        Hours
                    </dt><dd class="mt-2">
                        {business.location.hours}
                    </dd>
                </div><div>
                    <dt
                        class="font-bold uppercase tracking-widest text-[color:var(--muted)]"
                    >
                        Drop-off
                    </dt><dd class="mt-2">
                        Confirmed by WhatsApp before arrival
                    </dd>
                </div>
            </dl>
            <div class="location-map-frame">
                <iframe
                    src={business.location.mapsEmbedUrl}
                    title={`Map showing ${business.shortName} at ${business.location.displayAddress}`}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                ></iframe>
            </div>
            <a class="location-panel__map" href={business.location.directionsUrl} target="_blank" rel="noopener noreferrer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.71 11.29l-9-9a1 1 0 0 0-1.42 0l-9 9a1 1 0 0 0 0 1.42l9 9a1 1 0 0 0 1.42 0l9-9a1 1 0 0 0 0-1.42zM14 14.5V12h-4v2.5L7.5 12 10 9.5V12h4V9.5l2.5 2.5z"/></svg>
                Get directions <span class="sr-only">(opens Google Maps in a new tab)</span>
            </a>
        </div>
    </div>
</section>
