---
import '../styles/global.css';
import { business } from "../data/business";

interface Props {
title?: string;
description?: string;
}

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const structuredData = {
"@context": "https://schema.org",
"@type": "AutoRepair",
name: business.legalName,
description: business.description,
url: canonical.href,
telephone: business.contact.phone.e164,
email: business.contact.email.address,
address: {
"@type": "PostalAddress",
streetAddress: business.location.streetAddress,
addressLocality: business.location.locality,
addressRegion: business.location.region,
addressCountry: business.location.countryCode,
},
openingHours: "Mo-Fr 08:00-17:00",
areaServed: business.location.locality,
};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{business.shortName} | UAE Automotive Care</title>
<meta name="description" content={business.description} />
<link rel="canonical" href={canonical.href} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical.href} />
<meta property="og:title" content={`${business.shortName} | UAE Automotive Care`} />
<meta property="og:description" content={business.description} />
<meta property="og:image" content={ogImage.href} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#f5f3ee" />
<link
rel="icon"
href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%23d56b3e'/><text x='16' y='22' font-family='sans-serif' font-size='18' font-weight='bold' text-anchor='middle' fill='%2318201f'>V</text></svg>"
/>
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head>
<body class="bg-[#f5f3ee] text-[#18201f] antialiased">
<a class="skip-link" href="#main-content">Skip to main content</a>
<slot />
</body>
</html>
